"""
optimzed sol:
1. concatenate 
2. sum
time- O(n)
space complexity - O(1)
"""
class Solution:
    def addToArrayForm(self, num: list[int], k: int) -> list[int]:
        numbers = list()
        for number in num:
            numbers.append(str(number))
        final_output = int(''.join(numbers)) + k
        final_output = str(final_output)
        final_list = list()
        for i in range(len(final_output)):
            final_list.append(int(final_output[i]))
        return final_list
